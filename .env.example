# LLM 配置（OpenAI 兼容协议）——填写后自动启用 AI 深度评估
# DeepSeek 示例：
#   LLM_API_KEY=sk-xxxxxxxx
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
# OpenAI 示例：
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o
# 本地 Ollama 示例（Key 随便填非空值即可）：
#   LLM_API_KEY=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:14b

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 批量评估的 LLM 并发数（1-8，默认 4）
# 并发过高可能触发服务商限流（429 会终止整批）；同账号有其他应用占用配额时可调回 2
LLM_CONCURRENCY=4
